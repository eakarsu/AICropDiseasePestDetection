NODE_ENV=development
BACKEND_PORT=4400
FRONTEND_PORT=3400
DATABASE_URL=postgresql://cropguard:replace-me@localhost:5432/crop_disease_db
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3400
OPENROUTER_API_KEY=
# Provider adapters are disabled until configured and contract-tested.
WEATHER_PROVIDER_URL=
GIS_PROVIDER_URL=
SENSOR_WEBHOOK_SECRET=
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
